MYSQL_DSN=iot_user:iot_password@tcp(127.0.0.1:3306)/iot_vision?charset=utf8mb4&parseTime=True&loc=Local
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
STORAGE_ROOT=./storage
# LOCAL stores business images under STORAGE_ROOT. HUAWEI stores originals and thumbnails in Huawei OBS.
STORAGE_PROVIDER=LOCAL
# Object prefix used for original image objects when STORAGE_PROVIDER=HUAWEI.
STORAGE_OBJECT_PREFIX=original
DEVICE_TOKEN=course-demo-token
EDGE_DEDUP_ENABLED=true
AI_RPC_ENABLED=false
AI_RPC_ADDR=127.0.0.1:9000
AI_RPC_TIMEOUT_SECONDS=5
AI_IMAGE_FETCH_TIMEOUT_SECONDS=10
# Optional local GPU detection service. In Docker, worker reaches host service through host.docker.internal.
DETECTION_RPC_ENABLED=false
DETECTION_RPC_ADDR=host.docker.internal:9100
DETECTION_RPC_TIMEOUT_SECONDS=10
PUBLIC_GATEWAY_URL=http://127.0.0.1:5173
JWT_SECRET=course-demo-jwt-secret
JWT_EXPIRE_HOURS=24
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123456
CLOUD_API_ADDR=:8080
EDGE_NODE_ADDR=:8081
CLOUD_UPLOAD_URL=http://127.0.0.1:8080/api/images/upload

# Required when STORAGE_PROVIDER=HUAWEI. If HUAWEI_OBS_PUBLIC_URL is empty,
# cloud-api and worker generate signed read URLs for frontend and ai-service.
HUAWEI_OBS_ACCESS_KEY=
HUAWEI_OBS_SECRET_KEY=
HUAWEI_OBS_SECURITY_TOKEN=
HUAWEI_OBS_ENDPOINT=
HUAWEI_OBS_BUCKET=
HUAWEI_OBS_PUBLIC_URL=

# Protobuf generation helper.
PROTOC_PATH=D:\tools\protoc-35.0-rc-2-win64\bin\protoc.exe
